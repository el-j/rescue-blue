{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "unicorn",
    "typescript",
    "oxc",
    "vitest"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "typescript/no-explicit-any": "off",
    "vitest/require-mock-type-parameters": "off",
    "vitest/expect-expect": "off"
  },
  "env": {
    "browser": true,
    "builtin": true
  },
  "ignorePatterns": [
    "dist",
    "dist-ssr",
    "coverage",
    "node_modules"
  ]
}
